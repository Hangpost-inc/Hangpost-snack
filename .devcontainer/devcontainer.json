{
  "name": "hangpost-snack",
  "customizations": {
    "codespaces": {
      // Cross-repo access for the browser-only workflow: a codespace opened
      // on this repo can clone/push the sibling Hangpost repos and manage
      // their PRs with the built-in GITHUB_TOKEN. GitHub shows a one-time
      // authorization prompt when the codespace is created; grants apply to
      // NEW codespaces only. A listed repo the account can't reach (or a
      // renamed one) is silently skipped rather than erroring.
      "repositories": {
        "ai-bryguy101/Hangpost-Full-Stack": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        },
        "ai-bryguy101/Hangpost-Business": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        },
        "ai-bryguy101/Hangpost-marketing": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        },
        "ai-bryguy101/hangpost-legal": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        },
        "ai-bryguy101/Hangpost-Ideas": {
          "permissions": { "contents": "write", "pull_requests": "write" }
        }
      }
    }
  }
}
